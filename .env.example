TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_USER_ID=123456789
NORA_INTERVIEWER_USER_ID=123456789

# Primary provider: google | openai
AI_PROVIDER=google
AI_MAIN_MODEL=gemini-3.7-flash
AI_LOGIC_MODEL=gemini-3.5-flash-lite

# Optional OpenAI-compatible provider (used only with AI_PROVIDER=openai)
AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_key

# Temporary dialogue memory is isolated by chat + topic + user
CONTEXT_MAX_MESSAGES=20
CONTEXT_TTL_MINUTES=30

# Search: google | tavily | perplexity
SEARCH_PROVIDER=google
# TAVILY_API_KEY=your_tavily_key
PERPLEXITY_MODEL=perplexity/sonar

# Gemini projects: separate quotas, automatic key rotation per model
GOOGLE_GEMINI_API_KEY=your_google_key
# GOOGLE_GEMINI_API_KEY_2=your_second_google_key
GOOGLE_NATIVE_MODEL=gemini-3.7-flash
# Ordered conversational reserves (the legacy GOOGLE_FALLBACK_MODEL also works).
GOOGLE_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash
# 4 consecutive main failures -> 4 hours on reserve. One probe, then +1h on failure.
# Keep search separate: Gemini 3.x text grounding is not free in the API.
GOOGLE_SEARCH_MODEL=gemini-2.5-flash-lite
